@mastersthesis{beery2025towards,
  author   = {Beery, Aidan},
  title    = {Towards Automatic Household Food Waste Measurement with the Smart Compost Bin},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. project},
  degree   = {Master of Science in Computer Science},
  year     = {2025},
  month    = dec,
  advisor  = {Donnelly, Patrick J.},
  abstract = {The rising amounts of food waste across the world constitute an environmental, social, and economic disaster. Over 60\% of food waste is generated by household consumers, yet we currently lack reliable means to quantify this waste. A lack of publicly available image datasets of commingled food waste has prohibited researchers from leveraging advances in computer vision for the task of automatic food waste measurement. We present an AI-assisted compost bin that automatically measures kitchen compost waste by collecting waste images alongside environmental and weight data. We streamline the food waste annotation routine, combining weighing and imaging into a single step and enabling users to verbally label these waste images using onboard automatic speech recognition. We provide a companion mobile application as a platform for both instancelevel food waste image annotation and an analytics dashboard to inform users of their waste habits. We will deploy 55 of these compost bins in a forthcoming field study to curate a large, novel dataset of commingled food waste images. Additionally, we explore the feasibility of using pretrained CLIP models for open-vocabulary food waste object detection and assess the viability of transferring a model trained on uneaten food images to compost image recognition tasks.},
  keywords = {Sustainability},
  related  = {beery2024smart},
  pdf      = {theses/beery2025towards.pdf},
  slides   = {slides/beery2025towards.pdf},
  poster   = {posters/beery2025towards.pdf},
  bibtex_show = {true}
}

@mastersthesis{martin2025machine,
  author   = {Martin, Austin},
  title    = {Machine Learning-Based Real-Time Canine Seizure Detection Using a Smart Collar},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. project},
  degree   = {Master of Science in Computer Science},
  year     = {2025},
  month    = sep,
  advisor  = {Donnelly, Patrick J.},
  abstract = {Canine epilepsy affects 0.6–0.8\% of the domestic dog population. Seizures are extraordinarily stressful events for both dogs and their owners. Caretakers must be constantly vigilant and manually track seizure events for veterinary diagnoses and treatment recommendations. Existing commercial pet wearables lack the multimodal sensing capabilities and real-time processing required for reliable seizure detection, and previously proposed methods to monitor epilepsy are surgically invasive and difficult to deploy outside of clinical settings. This master’s project presents a complete Internet-of-Things (IoT) system for continuous and non-invasive canine activity monitoring, designed as a foundation for future seizure detection research. The implemented system integrates four key components: (1) a custom smart collar built on Arduino Nano RP2040 Connect hardware, capturing eight sensor channels (3-axis accelerometer, 3-axis gyroscope, temperature, and microphone amplitude) at 20 Hz; (2) a React Native Android application providing real-time data visualization, manual activity labeling, and alert management; (3) a robust AWS cloud architecture utilizing IoT Core, S3, and DynamoDB for scalable data ingestion and storage; and (4) dual-path connectivity supporting both direct Wi-Fi transmission and Bluetooth Low Energy proxy routing through the mobile application. The cloud pipeline successfully processes sensor windows with less than 2second latency over Wi-Fi and less than 10-second latency via cellular backup. The mobile application enables one-tap activity labeling across six behavioral categories (rest, walk, run, play, sleep, and seizure), which will enable the creation of a structured dataset for machine learning development. Using feature engineering, the system extracts multiple timeand frequency-domain characteristics from each 5-second sensor window, preparing the data for future for supervised learning experiments using Amazon SageMaker. This project contributes a production-ready platform incorporating solutions for critical pet wearable requirements: power management strategies, robust connectivity handling, and a streamlined user experience design. The complete system generates properly labeled, multi-modal sensor data suitable for future research into canine seizure detection algorithms. While actual seizure data collection will require veterinary collaboration and extended field studies, the implemented infrastructure provides the necessary technological foundation for advancing automated canine health monitoring from research concept to practical deployment.},
  keywords = {Health},
  pdf      = {theses/martin2025machine.pdf},
  bibtex_show = {true}
}

@mastersthesis{wang2025comparative,
  author   = {Wang, Shengxuan},
  title    = {Comparative Analysis of Sentiment in Chinese Opera with Different Features},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. project},
  degree   = {Master of Science in Computer Science},
  year     = {2025},
  month    = mar,
  advisor  = {Donnelly, Patrick J.},
  abstract = {Chinese Opera, recognized as an Intangible Cultural Heritage by UNESCO, represents the expression of traditional Chinese culture through its unique art form that combines singing, acting, and recitative. Understanding the emotional expression of Chinese Opera can help scholars and enthusiasts study it more deeply. There are many approaches to classify the emotional state of general music using deep learning with different models. This study will analyze and compare the performance of these methods on Chinese Opera using different features. We first conducted extensive data corrections and cleansing to address several data challenges in existing datasets of Chinese Opera, which we release as the Opera Singing Dataset-2025. We then compared the performance of spectrograms, raw audio, lyrics, and latent representation from pretrained models as features. The results demonstrate that models trained on lyrics outperformed all of the different acoustic features. Through this analysis, we conclude that the complexity of Chinese Opera performances added challenges not present with other types of music; challenges that are further aggravated by the lack of high quality annotated data. Many traditional approaches to automatic music sentiment analysis may not scale well to Chinese Opera, and as such, new and specific methods may need to be developed alongside the collection of additional labeled datasets.},
  keywords = {Music Emotion},
  pdf      = {theses/wang2025comparative.pdf},
  bibtex_show = {true}
}

