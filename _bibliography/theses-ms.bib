@mastersthesis{mccabe2026audiofree,
  author   = {McCabe, Peter},
  title    = {Audio-Free Timbre Classification with Text-Only Training},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. thesis},
  degree   = {Master of Science in Artificial Intelligence},
  year     = {2026},
  month    = mar,
  advisor  = {Donnelly, Patrick J.},
  abstract = {Text-only Training is a promising alternative machine learning paradigm for training multimodal models that does not require data from every modality. However, despite the potential of Text-only Training, its use as an approximation of, and replacement for, missing data for supervised learning in data-scarce environments remains under-explored. In this work I define the kinds of problems well suited to Text-only Training and examine techniques to label, generate, and design textbased training data. I address the Modality Gap’s effect on the performance of Text-only Training by extending and contrasting theoretically-justified methods with those commonly used in practice. I provide a case study on classifying subjective audio timbre descriptions based on three kinds of text-only training data, four models, and fourteen augmentation methods on eight audio-timbre datasets. Finally, my work shows that the Text-only Training paradigm successfully allows for the training of audio classifiers without real audio data, and lays the foundation for assessing Text-only Training in data-scarce supervised learning problems in general.},
  keywords = {Audio Tagging, Timbre, Language Models, Multimodal},
  related  = {mccabe2026classifying},
  url      = {https://ir.library.oregonstate.edu/concern/graduate_thesis_or_dissertations/ff365f73j},
  pdf      = {theses/mccabe2026audiofree.pdf},
  bibtex_show = {true}
}

@mastersthesis{leib2026time,
  author   = {Leib, Shaun},
  title    = {Time is Not on Your Side: Assessing the Value of Dynamic Audio Features for Static Music Emotion Labels},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. thesis},
  degree   = {Master of Science in Artificial Intelligence},
  year     = {2026},
  month    = apr,
  advisor  = {Donnelly, Patrick J.},
  abstract = {Music Emotion Recognition is an unsolved task within the field of Music Information Retrieval with a relatively stagnating state of the art. Within the problem there are two sub-tasks which we explore. Static emotion labeling considers a global predominant emotion label for the entire audio, whereas dynamic emotion labeling, or music emotion variance detection, considers emotion fluctuations over time. In our work, we analyze the embeddings of three pre-trained audio models (Wav2Vec 2.0, MERT, MAEST) in addition to handcrafted low/mid-level features to determine if temporally dynamic features can lead to higher performance on static emotion labels. Specifically, we examine if the information gained from dynamic features over temporally averaged global features from the same models lead to increased performance on statically labeled music. These experiments are performed utilizing the “Music Emotion Recognition next GEneration (MERGE)” dataset, a recently created music dataset which removes many of the issues prevalent in previous MER datasets. In addition, we test three levels of feature fusion in order to examine how our feature types interact, and we obtain the highest audio only performance on the MERGE dataset. Counter to our beliefs, we find that temporally dynamic features do not add additional information for static emotion labels.},
  keywords = {Music Emotion, Audio Models},
  related  = {leib2025interpreting},
  url      = {https://ir.library.oregonstate.edu/concern/graduate_thesis_or_dissertations/sb397j180},
  pdf      = {theses/leib2026time.pdf},
  slides   = {slides/leib2026time.pdf},
  bibtex_show = {true}
}

@mastersthesis{deleon2022automatic,
  author   = {De Leon, Daniel},
  title    = {Automatic Classification of Ultrasonic Harbor Porpoise Clicks in a Varying Noise Environment},
  school   = {Oregon State University},
  address  = {Corvallis, OR},
  type     = {M.S. thesis},
  degree   = {Master of Science in Computer Science},
  year     = {2022},
  month    = jun,
  advisor  = {Donnelly, Patrick J.},
  abstract = {This study compares three approaches in the design of an autonomous machine listening agent that predicts harbor porpoise ultrasonic echolocation clicks in diverse noise environments. Considering the temporal variations of noisy coastal ocean soundscapes which the harbor porpoises inhabit, we propose a leave-one-day-out (LODO) cross-validation strategy in the training of a random forest classifier that successfully addressed the covariate shift present in our time-series data. To evaluate the efficacy of our approach to capture signals in this noisy environment, we compare three preprocessing approaches and two deep learning architectures on our harbor porpoise click data. We find that feature extraction strategies of mel frequency cepstral coefficients (MFCC) and short time Fourier transform STFT outperformed our novel approach, the heterodyned-TKEO, which shifts down the ultrasonic signal to a lower frequency in the time domain. Building on these results, we seek to improve the robustness of our porpoise click classifier for a real world environment by implementing a second-stage stacked random forest ensemble on combinations of subsets of 42 CNN and LSTM base models that were trained from the folds of our LODO cross-validation and the three preprocessing approaches that were explored in this study. Our results demonstrate that experiments using the LODO cross-validation strategy reported a difference between the average fold accuracy and a held-out test accuracy of 6\%, while training without cross-validation and the equal k-fold crossvalidation reported a 28.7\% and 30.4\% difference, respectively. From the three preprocessing approaches we implement, the models trained on MFCC produced the highest accuracy of 95.6\% on the held-out test set while those trained on STFT and heterodyned-TKEO produced accuracies on the same held-out test set of 88.7\% and 85.0\%, respectively. Results from our stacked random forest show the greatest improvement in accuracy of 5.6\% in the heterodyned-TKEO models while the STFT and MFCC models reported 4.5\% and 1.9\% improvements in accuracy, respectively. Highly varying noise environments are common across coastal areas inhabited by harbor porpoises. This study, with our proposed ensemble of different feature and model architectures, emphasizes the need to overcome such shifts in noise to design a robust porpoise click classifier that is ready for real-time deployment and able to generalize to all real world conditions.},
  keywords = {Audio Tagging, Signal Processing, Bioacoustics},
  related  = {donnelly2022detecting},
  url      = {https://ir.library.oregonstate.edu/concern/graduate_thesis_or_dissertations/9k41zn95b},
  pdf      = {theses/deleon2022automatic.pdf},
  bibtex_show = {true}
}

