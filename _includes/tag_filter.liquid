{%- comment -%}
  Theme-tag filter bar. Usage: {% include tag_filter.liquid %}
  The tag list lives in _data/tags.yml; items to filter carry data-tags="A|B".
{%- endcomment -%}
<div class="sb-filter" role="toolbar" aria-label="Filter by theme">
  <a class="sb-chip" data-tag="" href="?">All</a>
  {%- for t in site.data.tags -%}
    <a class="sb-chip sb-t-{{ t | slugify }}" data-tag="{{ t }}" href="?tag={{ t | url_encode }}">{{ t }}</a>
  {%- endfor -%}
</div>
<div class="sb-filter-status" aria-live="polite" hidden>
  <span class="sb-filter-count"></span>
  <a class="sb-filter-clear" href="?">Clear filter</a>
</div>
<script src="{{ '/assets/js/tag-filter.js' | relative_url | bust_file_cache }}" defer></script>
