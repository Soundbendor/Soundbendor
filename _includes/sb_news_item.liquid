{%- assign n = include.n -%}
<article class="sb-news-item sb-kind-{{ n.kind | downcase }}">
  <div class="sb-news-meta">
    <span class="sb-news-date">{% if n.when %}{{ n.when }}{% else %}{{ n.date | date: '%b %-d, %Y' }}{% endif %}</span>
    <span class="sb-news-kind">{{ n.kind }}</span>
    {%- if n.alumni %}<span class="sb-news-kind sb-news-alumni">Alumni</span>{% endif -%}
  </div>
  <div class="sb-news-main">
    {%- if n.link contains '://' -%}{%- assign nl = n.link -%}{%- else -%}{%- assign nl = n.link | relative_url -%}{%- endif -%}
    <h3 class="sb-news-title">{% if n.link %}<a href="{{ nl }}">{{ n.title }}</a>{% else %}{{ n.title }}{% endif %}</h3>
    <div class="sb-news-source">{{ n.source }}</div>
    <div class="sb-news-summary">{{ n.content | strip_html | strip }}</div>
    {%- if n.links -%}
      <div class="sb-news-links">
        {%- for l in n.links -%}
          {%- if l.url contains '://' -%}{% assign u = l.url %}{%- else -%}{% assign u = l.url | relative_url %}{%- endif -%}
          <a href="{{ u }}">{{ l.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if n.image -%}
    <img class="sb-news-img" loading="lazy" src="{{ n.image | prepend: '/assets/img/' | relative_url }}" alt="">
  {%- endif -%}
</article>
