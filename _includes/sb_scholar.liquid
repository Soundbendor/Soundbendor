{%- comment -%} Publications & citations band on the PI page: publication counts (_data/pubcounts.yml, generated by
  scripts/sync_site.py from the bib) above the Google Scholar metrics table and citations-per-year bars (_data/scholar.yml, by hand). {%- endcomment -%}
{%- assign s = site.data.scholar -%}{%- assign pc = site.data.pubcounts -%}
<section class="sb-scholar" aria-labelledby="scholar-title">
  <div class="sb-scholar-head">
    <h3 id="scholar-title"><i class="ai ai-google-scholar"></i> Publications &amp; Citations</h3>
    <a class="sb-btn sb-btn-sm" href="{{ s.url }}">Google Scholar profile <i class="fa-solid fa-arrow-right"></i></a>
  </div>
  {%- if pc %}
  <p class="sb-pubcount"><span class="sb-pubcount-n">{{ pc.total }}</span> <span class="sb-pubcount-label">peer-reviewed publications</span>
    <span class="sb-pubcount-parts">{{ pc.journal }} journal articles<span class="sb-sep">•</span>{{ pc.conference }} conference papers<span class="sb-sep">•</span>{{ pc.chapter }} book chapters</span></p>
  {%- endif %}
  <div class="sb-scholar-body">
    <table class="sb-scholar-table">
      <thead><tr><th></th><th>All</th><th>Since {{ s.since }}</th></tr></thead>
      <tbody>
        {%- for r in s.rows -%}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.all }}</td><td>{{ r.since }}</td></tr>
        {%- endfor -%}
      </tbody>
    </table>
    <figure class="sb-scholar-chart" aria-label="Citations per year">
      <div class="sb-scholar-bars">
        {%- for y in s.per_year -%}
          {%- assign pct = y.n | times: 100 | divided_by: s.axis_max -%}
          <div class="sb-scholar-col" title="{{ y.year }}: about {{ y.n }} citations">
            <span class="sb-scholar-n">{{ y.n }}</span>
            <span class="sb-scholar-bar" style="height: {{ pct }}%;"></span>
            <span class="sb-scholar-year">{{ y.year }}</span>
          </div>
        {%- endfor -%}
      </div>
      <figcaption>Citations per year (Google Scholar)</figcaption>
    </figure>
  </div>
</section>
