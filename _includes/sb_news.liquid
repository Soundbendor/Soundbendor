{%- comment -%}
  News list. Usage: {% include sb_news.liquid %} (full page, grouped by year)
                    {% include sb_news.liquid limit=3 %} (compact, newest first)
  Each _news item: title, date, kind (Press|Award|Talk|Funding|Event|Service), source,
  link, optional image (under assets/img/), when (shown instead of the date),
  links (label/url list), student: true for student milestones; the body is a one- or
  two-sentence summary. With student=true, the compact list always includes a student item.
{%- endcomment -%}
{%- assign items = site.news | sort: "date" | reverse -%}
{%- if include.limit -%}
{%- assign shown = items | slice: 0, include.limit -%}
{%- if include.student -%}
  {%- comment -%} make sure at least one student item (student: true) is among them {%- endcomment -%}
  {%- assign n_student = shown | where: "student", true | size -%}
  {%- if n_student == 0 -%}
    {%- assign st = items | where: "student", true | first -%}
    {%- if st -%}
      {%- assign keep = include.limit | minus: 1 -%}
      {%- assign shown = items | slice: 0, keep | push: st -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
<div class="sb-news sb-news-compact">
  {%- for n in shown -%}{% include sb_news_item.liquid n=n %}{%- endfor -%}
</div>
{%- else -%}
{%- assign years = items | group_by_exp: "n", "n.date | date: '%Y'" -%}
<div class="sb-news">
  {%- for y in years -%}
  <h2 class="sb-year">{{ y.name }}</h2>
  {%- for n in y.items -%}{% include sb_news_item.liquid n=n %}{%- endfor -%}
  {%- endfor -%}
</div>
{%- endif -%}
