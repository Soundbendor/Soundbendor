{%- comment -%} One person. Usage: {% include person_card.liquid p=person compact=false %} {%- endcomment -%}
{%- assign p = include.p -%}
<div class="sb-person{% if include.compact %} sb-compact{% endif %}" id="{{ p.id }}" data-tags="{{ p.tags | join: '|' }}">
  <div class="sb-person-side">
    {%- if p.photo != "" -%}
      <img class="sb-photo" loading="lazy" src="{{ p.photo | prepend: '/assets/img/people/' | relative_url }}" alt="{{ p.name }}">
    {%- else -%}
      <img class="sb-photo sb-placeholder" loading="lazy" src="{{ '/assets/img/people/placeholder.png' | relative_url }}" alt="">
    {%- endif -%}
    <div class="sb-person-links">
      {%- if p.links.linkedin != "" %}<a class="sb-icon" href="{{ p.links.linkedin }}" aria-label="{{ p.name }} on LinkedIn"><i class="fa-brands fa-linkedin"></i></a>{% endif -%}
      {%- if p.links.github != "" %}<a class="sb-icon" href="{{ p.links.github }}" aria-label="{{ p.name }} on GitHub"><i class="fa-brands fa-github"></i></a>{% endif -%}
      {%- if p.links.website != "" %}<a class="sb-icon" href="{{ p.links.website }}" aria-label="{{ p.name }}'s website"><i class="fa-solid fa-globe"></i></a>{% endif -%}
      {%- if p.links.scholar != "" %}<a class="sb-icon" href="{{ p.links.scholar }}" aria-label="{{ p.name }} on Google Scholar"><i class="ai ai-google-scholar"></i></a>{% endif -%}
    </div>
  </div>
  <div class="sb-person-body">
    <div class="sb-name">
      {{ p.name }}
    </div>
    {%- capture sb_sep %}<span class="sb-sep">•</span>{% endcapture -%}
    {%- comment -%} Degree line: every degree with the lab in order, then major, then the year of the most recent finished degree {%- endcomment -%}
    {%- assign sb_parts = p.program | split: ', ' -%}
    {%- assign sb_main = sb_parts | first -%}
    {%- assign sb_major = p.program | remove_first: sb_main | remove_first: ', ' | replace: 'Computer Science', 'CS' | replace: 'Artificial Intelligence', 'AI' | replace: 'Mechanical Engineering', 'ME' | replace: 'Electrical Engineering', 'EE' | replace: 'Bioengineering', 'BioE' -%}
    {%- assign sb_names = "" -%}{%- assign sb_last = "" -%}
    {%- for d in p.other_degrees -%}
      {%- assign dn = d | split: ' ' | first -%}{%- assign sb_names = sb_names | append: '|' | append: dn | append: '|' -%}
      {%- assign dy = d | split: ' ' | last -%}{%- if dy != dn and dy > sb_last -%}{%- assign sb_last = dy -%}{%- endif -%}
    {%- endfor -%}
    {%- assign sb_names = sb_names | append: '|' | append: sb_main | append: '|' -%}
    {%- assign sb_degs = "" -%}
    {%- assign sb_order = "B.S.,M.S.,M.Eng.,Ph.D." | split: ',' -%}
    {%- for dn in sb_order -%}
      {%- assign needle = '|' | append: dn | append: '|' -%}
      {%- if sb_names contains needle -%}{%- if sb_degs != "" -%}{%- assign sb_degs = sb_degs | append: sb_sep -%}{%- endif -%}{%- assign sb_degs = sb_degs | append: dn -%}{%- endif -%}
    {%- endfor -%}
    {%- assign sb_year = p.year -%}
    {%- if sb_year == "" and p.status == "alumni" -%}{%- assign sb_year = sb_last -%}{%- endif -%}
    <div class="sb-meta">
      {{ sb_degs }}{% if sb_major != "" %}{{ sb_sep }}{{ sb_major }}{% endif %}{% if sb_year != "" %}{{ sb_sep }}{{ sb_year }}{% endif %}
      {%- if p.campus != "" %}<br><span class="sb-campus">{{ p.campus }}</span>{% endif -%}
      {%- if p.note != "" %}<br>{{ p.note }}{% endif -%}
    </div>
    {%- if p.now != "" %}<div class="sb-now">Now: {{ p.now }}</div>{% endif -%}
    {%- if p.activities.size > 0 -%}
      <div class="sb-badges">{% for a in p.activities %}<span class="sb-badge">{{ a | replace: "Honors", "HC" | replace: "Capstone", "Cap" }}</span>{% endfor %}</div>
    {%- endif -%}
    {%- comment -%} Work links by category (Paper, Thesis, Project, Capstone), each to the most recent item {%- endcomment -%}
    {%- assign n_pap = 0 -%}{%- assign y_pap = 0 -%}{%- assign k_pap = "" -%}
    {%- for k in p.papers -%}{%- assign info = site.data.bibkeys[k] -%}{%- if info -%}
      {%- assign n_pap = n_pap | plus: 1 -%}{%- assign sb_y = info.year | plus: 0 -%}
      {%- if sb_y > y_pap or k_pap == "" -%}{%- assign y_pap = sb_y -%}{%- assign k_pap = k -%}{%- endif -%}
    {%- endif -%}{%- endfor -%}
    {%- assign n_th = 0 -%}{%- assign y_th = 0 -%}{%- assign k_th = "" -%}
    {%- for k in p.theses -%}{%- assign info = site.data.bibkeys[k] -%}{%- if info -%}
      {%- assign n_th = n_th | plus: 1 -%}{%- assign sb_y = info.year | plus: 0 -%}
      {%- if sb_y > y_th or k_th == "" -%}{%- assign y_th = sb_y -%}{%- assign k_th = k -%}{%- endif -%}
    {%- endif -%}{%- endfor -%}
    {%- assign n_pr = 0 -%}{%- assign y_pr = 0 -%}{%- assign k_pr = "" -%}
    {%- assign n_cap = 0 -%}{%- assign y_cap = 0 -%}{%- assign k_cap = "" -%}
    {%- for pid in p.projects -%}{%- assign pr = site.data.projects | where: "id", pid | first -%}{%- if pr -%}
      {%- assign sb_y = pr.year | plus: 0 -%}
      {%- if pr.type == "Capstone" -%}
        {%- assign n_cap = n_cap | plus: 1 -%}{%- if sb_y > y_cap or k_cap == "" -%}{%- assign y_cap = sb_y -%}{%- assign k_cap = pid -%}{%- endif -%}
      {%- else -%}
        {%- assign n_pr = n_pr | plus: 1 -%}{%- if sb_y > y_pr or k_pr == "" -%}{%- assign y_pr = sb_y -%}{%- assign k_pr = pid -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}{%- endfor -%}
    {%- assign n_all = n_pap | plus: n_th | plus: n_pr | plus: n_cap -%}
    {%- if n_all > 0 -%}
      <div class="sb-work">
        {%- if n_pap > 0 -%}<a href="{{ site.data.bibkeys[k_pap].page | relative_url }}#{{ k_pap }}">{% if n_pap > 1 %}{{ n_pap }} Papers{% else %}Paper{% endif %}</a>{%- endif -%}
        {%- if n_th > 0 -%}<a href="{{ site.data.bibkeys[k_th].page | relative_url }}#{{ k_th }}">{% if n_th > 1 %}{{ n_th }} Theses{% else %}Thesis{% endif %}</a>{%- endif -%}
        {%- if n_pr > 0 -%}<a href="{{ '/projects/' | relative_url }}#{{ k_pr }}">{% if n_pr > 1 %}{{ n_pr }} Projects{% else %}Project{% endif %}</a>{%- endif -%}
        {%- if n_cap > 0 -%}<a href="{{ '/projects/' | relative_url }}#{{ k_cap }}">{% if n_cap > 1 %}{{ n_cap }} Capstones{% else %}Capstone{% endif %}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
